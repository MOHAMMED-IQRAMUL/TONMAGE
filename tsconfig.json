{
  "compilerOptions": {
    "rootDir": "./src",
    "outDir": "./dist",

    "module": "ESNext",
    "moduleResolution": "Node",
    "target": "ESNext",

    "jsx": "react-jsx",

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "exactOptionalPropertyTypes": true,
    "isolatedModules": true,
    "skipLibCheck": true,

    // ✅ Recommended to avoid case issues
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src"]
}
